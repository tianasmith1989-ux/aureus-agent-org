# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real keys.

# ── Anthropic (NEW — create at console.anthropic.com, set a monthly spend limit) ──
# Required for the agents to run. Lives ONLY on the server.
ANTHROPIC_API_KEY=

# ── Supabase (your existing Aureus project) ──
# Server-only. Used by the API routes to read/write the database.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Safe to expose to the browser (not used yet in Step 1, here for later steps).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Clerk (Step 2) — gates the whole app + every API route ──
# From the Clerk dashboard → API Keys. Required for the app to load once auth is on.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Point Clerk at the in-app auth pages (app/sign-in, app/sign-up).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── Added in later steps (leave blank until then) ──
# Stripe (Step 3) — create the products/prices in the Stripe dashboard (see README)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TRIAL=                 # $1 every 7 days (weekly recurring)
STRIPE_PRICE_MONTHLY=              # $14.99 / month
STRIPE_PRICE_ANNUAL=              # $99 / year

# Resend (Step 4) — verify your sending domain, then set the From identity
RESEND_API_KEY=
RESEND_FROM="Aureus Plutus <noreply@aureusplutus.app>"

# Public app URL used in email links (no trailing slash)
NEXT_PUBLIC_APP_URL=https://aureusplutus.app

# Secret that protects the Vercel Cron endpoints (Steps 4 & 5).
# Generate a random string; Vercel sends it as a Bearer token to /api/cron/*.
CRON_SECRET=

# Ayrshare (Step 5, optional) — social auto-posting
AYRSHARE_API_KEY=

# ── Founder Cockpit monitoring (Phase 2c, optional) — READ-ONLY, drafts only ──
# Reddit Data API (create a "script"/"web app" at reddit.com/prefs/apps; OAuth).
# NOTE: Reddit's free tier is NON-COMMERCIAL and requires app approval — confirm
# your use qualifies before enabling. See README.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT="aureus-cockpit/1.0 by u/yourusername"
# YouTube Data API v3 (API key from Google Cloud Console; free within daily quota).
YOUTUBE_API_KEY=
