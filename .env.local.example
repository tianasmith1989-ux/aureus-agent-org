# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real keys.

# ── Anthropic (NEW — create at console.anthropic.com, set a monthly spend limit) ──
# Required for the agents to run. Lives ONLY on the server.
ANTHROPIC_API_KEY=

# ── Supabase (your existing Aureus project) ──
# Server-only. Used by the API routes to read/write the database.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Safe to expose to the browser (not used yet in Step 1, here for later steps).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Added in later steps (leave blank for Step 1) ──
# Clerk (Step 2)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Stripe (Step 3)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TRIAL=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
# Resend (Step 4)
RESEND_API_KEY=
# Ayrshare (Step 5, optional)
AYRSHARE_API_KEY=
